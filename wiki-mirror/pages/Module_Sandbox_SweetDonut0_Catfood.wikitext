local getArgs = require('Module:Arguments').getArgs

function p.random(frame)
	args = getArgs(frame)
	math.randomseed(os.time() + args[1] * os.clock() * 10^2)
	for i = 1, 10, 1 do
		math.random()
	end
	return math.random()
end

function p.randInt(frame)
	args = getArgs(frame)
	math.randomseed(os.time() + os.clock() * 10^2)
	for i = 1, 10, 1 do
		math.random()
	end
	return math.random(args[1], args[2])
end

