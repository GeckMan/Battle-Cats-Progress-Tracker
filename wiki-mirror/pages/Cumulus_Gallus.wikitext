|name = Cumulus Gallus
|image = E 624.png
|money drop = 1,500¢ - 5,925¢
|first appearance = [[Hidden Forest of Gapra]]<br>[[Empress' Excavation 3]]<br>'''UL''': [[Ape Lord's Revenge|Sub-chapter 48 - Ape Lord's Revenge]]
