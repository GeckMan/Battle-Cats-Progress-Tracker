.mission-table {
	background: url("https://static.wikitide.net/battlecatswiki/6/6a/MissionBackground.png");
	border-radius: 5px;
	padding: 12px;
	margin: 0.25em 0;
	max-width: 600px;
	display: flex;
	flex-direction: column;
	row-gap: 10px;
}

.mission-table .mission-entry {
	min-height: 70px;
	border-radius: 5px;
	border: 2px solid black;
	display: grid;
	grid-template-areas:
		"image condition"
		"image separator"
		"image reward   ";
	grid-template-columns: 90px 1fr;
	background-color: rgb(0, 0, 0, 0.5);
}

.mission-table .mission-entry.special {
	background-color: rgb(0, 62, 120, 0.5);
}

.mission-table .mission-entry.monthly {
	background-color: rgb(48, 89, 0, 0.5);
}

.mission-table .mission-entry.weekly {
	background-color: rgb(154, 0, 0, 0.5);
}

.mission-table .image-wrapper {
	grid-area: image;
	border-width: 3px;
	border-style: solid;
	border-color: black;
	align-self: center;
	justify-self: center;
}

.mission-table .condition {
	grid-area: condition;
	font-size: 12px;
	font-weight: bold;
	font-family: helvetica;
	color: #FBFBFC;
	line-height: 1.2;
	padding-right: 10px;
	align-self: center;
}

.mission-table .condition a {
	color: #FBFBFC;
}

.mission-table .separator {
	grid-area: separator;
	height: 1.5px;
	background-color: black;
	margin-right: 10px;
	align-self: center;
}

.mission-table .reward {
	grid-area: reward;
	font-size: 12px;
	font-weight: bold;
	font-family: helvetica;
	color: #FFF200;
	padding-right: 10px;
}

.mission-table .reward a {
	color: #FFF200;
}