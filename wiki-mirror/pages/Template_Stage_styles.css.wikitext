.stage-custom-template {
	display: inline-block;
	text-align: center;
	line-height: 1em;
}

.stage-custom-template > div {
	position: relative;
	width: 245px;
	margin-left: auto;
	margin-right: auto;
	max-width: 100%;
	overflow-x: auto;
}

.stage-custom-template > div > span:not(:nth-child(3)) {
	display: inline-block;
	overflow: hidden;
	padding: 0;
	border-radius: 0px;
	position: absolute;
}

.stage-custom-template > div > span:nth-child(1) {
	left: 47px;
	top: 3px;
}

.stage-custom-template > div > span:nth-child(1) img {
	width: 155px;
	height: 39px;
}

.stage-custom-template > div > span:nth-child(2) {
	left: 7px;
	top: 23px;
}

.stage-custom-template > div > span:nth-child(2) img {
	width: 40px;
	height: 11px;
}

.stage-custom-template > div > span:nth-child(3) img {
	width: 245px;
