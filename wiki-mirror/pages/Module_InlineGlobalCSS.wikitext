---	Inlines Global.css's `@import`s which... makes it better ig? Superseded by
--	[[MediaWiki:Gadget-core]].
--
--	@author [[User:Jenny on Wiki|Jenny on Wiki]]
local p = {}
local util = require("Module:Utility")

local top = [=[/*
This page is entirely generated by Lua. See [[MediaWiki:Global.css]]
for the actual editable part.
<pre>
*/
]=]
local style_end = "/* <pre> */"

function p.main(frame)
	-- local css = mw.title.new("MediaWiki:Global.css"):getContent()
	local css = util.getPageContent("MediaWiki:Global.css")

	css = css:gsub('@import url.-&title=([^%&%"]+)[^\n]*', function(title)
		local content = util.getPageContent(title)

		if content:match("^%{%{#invoke:") then
			if content:match("InlineGlobalCSS") then
				return ''
			end
			return frame:preprocess(content)
		else
			return content
		end
	end)

	css = css:gsub("/%*.-%*/", "")
	css = css:gsub("%s*\n", "\n")
	-- robust stuff
	-- if true then return css end

	css = css:gsub("\n+\t+", "")
	css = css:gsub("%{\n+", "{")
	css = css:gsub("\n+%}", "}")
	css = css:gsub("([,%}])\n([%.:@#])", "%1%2")
	-- more experimental
	-- would probably be better to use a real css parser but eh

	return css
end

return p

--[=[
mw.log(p.main(mw.getCurrentFrame()))
]=]