.labyrinth-stages .tabber .tabber__header {
	border: none;
	box-shadow: none;
}
.labyrinth-stages .tabber .tabber__header .tabber__tabs {
	background: transparent;
	padding: 3px 0;
	text-align: center;
	flex-wrap: wrap;
	justify-content: center;
	gap: 2px 0;
}
.labyrinth-stages .tabber .tabber__tabs {
	margin: 0;
	height: auto;
}
.labyrinth-stages .tabber a.tabber__tab {
	background: var(--bg-color-creamy-yellow);
	border: none;
	font-family: Helvetica, Sans-serif;
	font-size: 0.75rem;
	font-weight: 300;
	padding: 6px 12px;
	box-shadow: 1px 1px 2px currentColor;
	margin-bottom: 1px;
}
#mw-content .labyrinth-stages .tabber a.tabber__tab {
	text-decoration: none;
}
.labyrinth-stages .tabber a.tabber__tab[aria-selected="true"] {
	background: var(--bg-color-light4);
}

