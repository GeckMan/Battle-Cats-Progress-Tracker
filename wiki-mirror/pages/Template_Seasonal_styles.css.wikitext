.ranger-navbox.seasonal {
	--bg-navbox-title: linear-gradient(to right, hsl(205, 100%, 75%) 0%, hsl(180, 100%, 75%) 50%, hsl(205, 100%, 75%) 100%);
	--bg-sub-table-title: linear-gradient(to right, hsl(334, 100%, 67%) 0%, hsl(308, 100%, 75%) 50%, hsl(334, 100%, 67%) 100%);
	--bg-group-name: linear-gradient(to right, hsl(49, 100%, 62%) 0%, hsl(50, 100%, 75%) 100%);
	--group-color: #000;
}

