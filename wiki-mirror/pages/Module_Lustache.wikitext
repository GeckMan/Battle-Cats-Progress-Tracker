-- Beginning of Scribunto module for interfacing with MediaWiki

local p = {}

local getArgs = require("Module:Arguments").getArgs

-- Note to dev wiki editors: this function is copied from Module:Example.
-- Changes to this function should be synced with the source.
local function unescape(text)
	if not text:match("UNIQ") then
		return text;
	end
	local unescaped = mw.text.unstripNoWiki(text);
	local text, count = string.gsub(unescaped, "&lt;", "<");
	text, count = string.gsub(text, "&gt;", ">");
	text, count = string.gsub(text, "<//nowiki>", "</nowiki>");
	return text;
end

local function loadInputData(args)
	if args.module then
		return mw.loadData(args.module)
	end
	if args.page then
		return mw.loadJsonData(args.page)
	end
	if args.data then
		return mw.text.jsonDecode(args.data)
	end
	error('Must specify a JSON data source via |page= or inline JSON via |data=')
end

local function getKeys(t)
	local result = {}
	for k, _ in pairs(t) do
		table.insert(result, tostring(k))
	end
	return table.concat(t, ", ")
end

local function traversePath(data, path)
  if path == "." then
    return data
  end

  local value = data
  local pos = 1

  local function fail(message)
    error("Invalid path '" .. path .. "': " .. message)
  end

  while pos <= #path do
    if string_sub(path, pos, pos) ~= "." then
      fail("expected '.' at position " .. pos)
    end
    pos = pos + 1

    local key = string_match(path, "^([%w_%-]+)", pos)
    if key then
      if type(value) ~= "table" then
        fail("cannot access key '" .. key .. "' on a non-table value")
      end
      local original = value
      value = value[key]
      if value == nil then
      	mw.logObject(original)
        fail("key '" .. key .. "' was not found, available keys: " .. getKeys(original))
      end
      pos = pos + #key
    end

    local indexed = false
    if string_sub(path, pos, pos) == "[" then
      indexed = true
      local index = string_match(path, "^%[(%d+)%]", pos)
      if not index then
        fail("expected numeric array index at position " .. pos)
      end
      if type(value) ~= "table" then
        fail("cannot index a non-table value")
      end
      value = value[tonumber(index)]
      if value == nil then
        fail("array index " .. index .. " was not found")
      end
      pos = pos + #index + 2
    end

    if not key and not indexed then
      fail("expected key or array index at position " .. pos)
    end
  end

  return value
end

function p.main(frame)
  local args = getArgs(frame)
  if not args.template then
    error("The 'template' argument must be specified.")
  end
  local template = unescape(args.template or "")

  local data = loadInputData(args)

  if args.path then
    data = traversePath(data, args.path)
  end

  local rendered = lustache:render(template, data)

  if args.preprocess then
    rendered = frame:preprocess(rendered)
  end

  return rendered
end

return p