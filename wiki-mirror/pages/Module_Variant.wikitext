---	Backend of the [[Template:Variant|Variant]] template.
--
--	@author [[User:Jenny on Wiki|Jenny on Wiki]]
--	@require Module:Enemies
local p = {}
local Enemy = require('Module:Enemies')
local getArgs = require('Module:Arguments').getArgs
local yesno = require('Module:Yesno')

local ORIGINAL = "original"
local INHERIT_DESC = "inherit_desc"

local function get_enemy(name)
	local enemy = Enemy.new(name)
	if enemy.name ~= name then
		local fmt = "%s is not a valid enemy name (replace with `%s`)"
		error(fmt:format(name, enemy.name))
	end
	return enemy
end

---	Get full table row for individual variant
--	@param {string} name
--	@param {string} desc
--	@return {string} Wikitext table row
function p.tr(name, desc)
	local enemy = get_enemy(name)
	local icon = ('[[File:%s|center|link=%s|%s]]'):format(enemy:icon(), enemy.link, enemy.name)
	local tr = { '|-', enemy.page, icon, desc }
	return table.concat(tr, '\n|')
end

function p.get_inherited_descs(do_put, current, args)
	local where = {}

	for _, variant in ipairs(args) do
		table.insert(where, { "variant", variant })
		if do_put then
			mw.bucket('variant').put({
				original = current,
				variant = variant,
			})
		end
	end

	local bucket = mw.ext.bucket
	local query = bucket('variant')
		.select('variant', 'description')
		.where(bucket.Or(unpack(where)))
		.where({ 'description', '!=', bucket.Null() })

	local desc_map = {}
	for _, variant_obj in ipairs(query.run()) do
		if desc_map[variant_obj.variant] then
			desc_map[variant_obj.variant] = desc_map[variant_obj.variant]
				.. '\n\n' .. 'Alternative description: '
				.. variant_obj.description
		else
			desc_map[variant_obj.variant] = variant_obj.description
		end
	end

	local variants = {}
	for _, variant in ipairs(args) do
		table.insert(variants, p.tr(variant, desc_map[variant]))
	end

	return table.concat(variants, '\n')
end

function p._main(args)
	local do_put = mw.title.getCurrentTitle().namespace == 0

	local current_unit = args[ORIGINAL]
	if do_put then
		get_enemy(current_unit)
		-- will throw an error if current_unit isn't an actual unit
	end
	local inherit_desc = yesno(args[INHERIT_DESC])

	if inherit_desc then
		return p.get_inherited_descs(do_put, current_unit, args)
	end

	local i = 0
	local variants = {}

	while true do
		local name = args[i + 1]
		local desc = args[i + 2]
		if not (name) then break end

		i = i + 2
		if do_put then
			mw.bucket('variant').put({
				original = current_unit,
				variant = name,
				description = desc,
			})
		end
		table.insert(variants, p.tr(name, desc))
	end

	return table.concat(variants, '\n')
end

function p.main(frame)
	return p._main(getArgs(frame))
end

return p

