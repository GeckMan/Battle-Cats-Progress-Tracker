|image = E 261.png
|first appearance = '''SoL''': [[Lord of the Abyss|Sub-chapter 30 - Lord of the Abyss]]
|latest appearance = '''ZL:''' [[Forest of Irony|Sub-chapter 9 - Forest of Irony]]
