/* overlay transparent checkbox over image icons */
.cat-filter-container .cat-filter-icon-button {
	position: relative;
}

.cat-filter-container .cat-filter-icon-button input[type="checkbox"] {
	position: absolute;
	bottom: 0;
	left: 0;
	height: 100%;
	width: 100%;
	margin: 0;
	opacity: 0;
	z-index: 2;
	cursor: pointer;
}

.cat-filter-container .filter-data-wrapper {
	display: flex;
	flex-wrap: wrap;
	padding: 3px;
	gap: 3px;
}

/* off state for icon checkboxes */
.cat-filter-container .cat-filter-icon-button img {
	filter: grayscale(100%) brightness(75%);
}

/* on state for icon checkboxes */
.cat-filter-container .cat-filter-icon-button input:checked + span img {
	filter: grayscale(0%) brightness(100%);
}

/* active state for icon checkboxes */
.cat-filter-container .cat-filter-icon-button input:active + span img {
	filter: grayscale(50%) brightness(50%);
}

/* adjustment of checkbox size for talent and ultra talent icons */
.cat-filter-container .cat-filter-icon-button-talent input[type="checkbox"] {
	width: 100%;
	height: 100%;
}

.cat-filter-container .cat-filter-icon-button-ultratalent input[type="checkbox"] {
	height: 100%;
	width: 100%;
}

/* styling for AND/OR switch */
.cat-filter-container .cat-filter-switch {
	position: relative;
	display: inline-block;
	width: 56px;
	height: 24px;
	border-radius: 12px;
	border: 1px solid #000;
}

.cat-filter-container .cat-filter-switch input {
	opacity: 0;
	width: 0;
	height: 0;
}

.cat-filter-container .cat-filter-toggle {
	position: absolute;
	cursor: pointer;
	top: 0;
	left: 0;
	right: 0;
	bottom: 0;
	background-color: #FFA500;
	transition: .2s;
	border-radius: 22px;
}

.cat-filter-container .cat-filter-toggle::before {
	position: absolute;
	content: "";
	height: 16px;
	width: 24px;
	left: 4px;
	top: 3px;
	background-color: white;
	transition: .2s;
	border-radius: 8px;
}

.cat-filter-container input:checked+.cat-filter-toggle::before {
	transform: translateX(22px);
}

.cat-filter-container .on {
	position: absolute;
	left: 38px;
	top: 11px;
	transform: translate(-50%, -50%);
	color: #FFA500;
	font-size: 10px;
}

.cat-filter-container .off {
	position: absolute;
	left: 16px;
	top: 11px;
	transform: translate(-50%, -50%);
	color: #FFA500;
	font-size: 10px;
}

.cat-filter-container .ability-button {
	width: 40px;
	height: 40px;
}

.cat-filter-container .rarity-button {
	width: 143px;
	height: auto;
	transform: scale(0.9);
}

/* styling for submit button */
.cat-filter-container #filter-submit {
	width: 96px;
	height: 36px;
	background-color: #FFA500;
	border-radius: 8px;
	color: #FFF;
	font-weight: bold;
	font-size: 16px;
	border: 2px solid #000;
	cursor: pointer;
}

.cat-filter-container #filter-submit:active {
	background-color: #FF8C00;
}

/* styling for clear button */
.cat-filter-container #filter-clear {
	width: 72px;
	height: 36px;
	background-color: #777;
	border-radius: 8px;
	color: #FFF;
	font-weight: bold;
	font-size: 15px;
	border: 2px solid #000;
	cursor: pointer;
}

.cat-filter-container #filter-clear:active {
	background-color: #666;
}

.cat-filter-container #filter-result {
	width: 100%;
	min-height: 74px;
	border-radius: 10px;
	border: 2px solid var(--color-max-contrast);
	margin-top: 10px;
	overflow-y: auto;
	background: url("https://static.wikitide.net/battlecatswiki/6/6a/MissionBackground.png");
	text-align: center;
	line-height: 0;
	resize: vertical;
}

