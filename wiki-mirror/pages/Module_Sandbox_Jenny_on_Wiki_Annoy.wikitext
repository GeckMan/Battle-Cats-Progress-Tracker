local pages = {}
local csv = require("Module:CSV")
local Enemy = require("Module:Enemies")
local Cat = require("Module:Cat2")
require('Module:Cat2/string_functions').init(Cat)
require('Module:Cat2/load_bulk_data').init(Cat)

local HIDE_RAW = true

local function strip_pre(content)
	content = content:match("<pre>(.*)</pre>")
	return content
end

local function unescape(content)
	content = content:gsub('""', '"')
	return content
end
local function catlink(cat)
	local link = cat:image_str('deploy', { link = "" }, ""):gsub('|link=|', '')
	return link
end
local function filter_links(link)
	local l = link:gsub("[|#][^\n]-%f[%]]", "")
	return l
end

---	Stolen from [[Module:Utility]].
--	@param {string} pageName Full name of the page (inc. namespace)
--	@return {string} content Full content of the page
local function getPageContent(pageName)
	-- Some namespaces have different methods of getting page content
	local namespaces = {}
	-- mediawiki namespace just had to be different
	namespaces.mediawiki = function(page)
		page = mw.message.new(page:sub(11))
		return tostring(page)
	end
	namespaces.special = function(_)
		error('Cannot obtain content from a special page!')
	end
	local default = function(page)
		page = mw.title.new(page)
		return page:getContent()
	end

	-- checks the namespace for a function in the table above
	local getPage = namespaces[pageName:match('^[^:]*'):lower()] or default
	return getPage(pageName)
end

