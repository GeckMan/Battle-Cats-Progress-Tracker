pages["MediaWiki:Sidebar"] = function(page)
	local content = getPageContent(page)

	content = content:gsub("%*[^|\n]+\n", "")
	content = content .. "\n"
	-- adding a new line to the end means the rest doesn't have to try and match
	-- $ as well, they just need to worry about new lines
	content = content:gsub("%*%* *[a-z]+%-url|[^\n]*\n", "")
	content = content:gsub("%*%* *mainpage|mainpage%-description\n", "")
	-- remove:
	-- lines without pipe
	-- lines that follow the format of ("**", lowercase letters, "-url|")
	-- mainpage description

	content = content:gsub("%*+(.-)%f[\n]", "[[:%1]]")
	-- got rid of all other lines so rest should all function as links

	return content
end
pages["MediaWiki:ExtendedSidebar"] = function(page)
	local content = getPageContent(page)
	content = content:gsub("%*[^|\n]+\n", "")
	content = content:gsub("%*+(.-)%f[\n]", "[[:%1]]")
	content = content:gsub("%*+(.-)$", "[[:%1]]")
	-- Put links in
	-- content = content:gsub("%[%[:[A-Z]+%]%]", "")
	-- Remove like [[TOOLBOX]] since they're there because... idk
	return content
end
pages["Template:CurrentEvents/Images.json"] = function(page)
	local content = mw.loadJsonData(page)
	local t = {}
	local i = {}
	for key, value in pairs(content) do
		table.insert(t, ("%s = [[%s]]"):format(key, value.page))
		local img = value.img:match('https://static.wikitide.net/battlecatswiki/./../(.*)') or "file that doesn't exist" .. key
		table.insert(i, ("%s = [[File:%s|10px]]"):format(key, img))
	end

	return table.concat(t) .. table.concat(i)
end

