pages["Module:Enemies.csv"] = function(page)
	-- do this to make this not such a bottleneck
	local content = getPageContent(page)
	local t = {}
	-- 2nd column contains name
	for name in content:gmatch("\n[%d]-\t([^\n]-)\t[^\n]*") do
		-- I CBA to write a separate case for codename red riding or something
		-- so just use `csv.read`
		local link = Enemy.new(csv.read(name)()[1]).page
		table.insert(t, link)
	end
	return table.concat(t, "\n")
end
pages["Module:Stamps.csv"] = function(page)
	local content = getPageContent(page)
	local t = {}
	content = csv.read(content)
	-- remove header
	content()
	for line in content do
		local link = ("[[%s]]"):format(line[3])
		if link ~= '[[]]' then
			table.insert(t, link)
		end
	end
	return table.concat(t, "\n")
end
pages["Module:GachaDescription/descs.csv"] = function(page)
	local content = getPageContent(page)
	local t = {}
	content = csv.read(content, { delim = "|" })
	-- remove header
	content()
	for line in content do
		local link = Cat.str.page_link(Cat.from_name(line[1]))
		table.insert(t, link)
	end
	return table.concat(t, "\n")
end

pages["User:Jenny on Wiki/data/StageNames.csv"] = function(page)
	local content = getPageContent(page)
	content = content
		:gsub("\n%d%d%d,%d%d%d,%d%d%d,", "\n")
		:gsub("\n%d%d%d,%d%d%d,,", "\n")
	return unescape(strip_pre(filter_links(content)))
end
pages["User:Jenny on Wiki/data/EnemyLinkData.csv"] = function(page)
	local content = getPageContent(page)
	return unescape(strip_pre(content))
end
