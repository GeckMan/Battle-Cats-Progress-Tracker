local p = {}
function p.list()
	local t = {}
	for page, _ in pairs(pages) do
		table.insert(t, ("*[[%s]]"):format(page))
	end
	return table.concat(t, "\n")
end

local format = [=[===[[%s]]===
<div class="template-collapsible mw-collapsible mw-collapsed" data-expandtext="Expand" data-collapsetext="Collapse">
%s
</div>
<div style="clear:both; margin: 0; padding: 0"></div>
]=]
function p.main(frame)
	local t = {}
	for page, f in pairs(pages) do
		local success, result = pcall(f, page)
		local content
		if success then
			content = format:format(page, result)
		else
			content = ("===[[SCRIPT ERROR]] on page [[%s]]: %s===")
				:format(page, result)
		end
		table.insert(t, content)
	end
	return table.concat(t, "\n")
end

return p

