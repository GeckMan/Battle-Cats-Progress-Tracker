---	Module providing various functions for Update pages, as used in
--	[[Template:Update]].
--
--	@author [[User:Jenny on Wiki|Jenny on Wiki]]
--	@require Module:NewEnemies
--	@require Module:NewCats
--	@require Module:NewTrueForms
--	@todo Perhaps something for medals?
local p = {}

---	Display new enemies
--	@param {Frame} frame
--	@return New enemies
function p.enemies(frame)
	return require("Module:NewEnemies").main(frame)
end

---	Display new cats
--	@param {Frame} frame
--	@return New cats
function p.cats(frame)
	return require("Module:NewCats").main(frame)
end

---	Display new True Forms
--	@param {Frame} frame
--	@return New True Forms
function p.trueforms(frame)
	return require("Module:NewTrueForms").main(frame)
end

---	Display new Ultra Forms
--	@param {Frame} frame
--	@return New Ultra Forms
function p.ultraforms(frame)
	frame.args.ultra = true
	return require("Module:NewTrueForms").main(frame)
end

---	Display new talents
--	@param {Frame} frame
--	@return New talents
function p.talents(frame)
	-- bit sneaky doing the same thing as true forms for now
	return require("Module:NewTrueForms").main(frame)
end

---	Invoke entrypoint (TO BE USED IN TEMPLATE ONLY, DO NOT INVOKE DIRECTLY)
--	@param {Frame} frame Child frame
function p.main(frame)
	frame = frame:getParent()

	local methodName = frame.args["mode"]:lower()
	local method = p[methodName]
		or error(("%s is not a valid method name!"):format(methodName))

	for arg in pairs(frame.args) do
		assert(type(arg) == "number" or arg == "mode",
			('Argument "%s" not recognised!'):format(arg))
	end

	return method(frame)
end

return p

