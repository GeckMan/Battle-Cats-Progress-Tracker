---	To generate tables containing new true forms in update pages.
--
--	@author [[User:Jenny on Wiki|Jenny on Wiki]]
--	@require Module:Cats
local p = {}
local getArgs = require('Module:Arguments').getArgs
local Cat = require('Module:Cat2')
require('Module:Cat2/images').init(Cat)
local cat_query = require('Module:Cat query helper')

-- Wikitext for table
local tableBase = [[{| class="article-table update-table" border="0" cellspacing="1" cellpadding="1"
|-
! scope="col" |CRO
! scope="col" |Unit
! scope="col" |Rarity
! scope="col" |Changes
%s
|}]]
local rowBase = [[|-
|%03d
|%s
|%s
|%s
]]

--- Generate table wikitext
function p._main(args)
	local argsMax = 2
	local i = 0
	-- run through args in multiples of argsMax as in Nyanko
	local cats = {}
	local data = {}
	while true do
		local name = args[argsMax * i + 1]
		local changes = args[argsMax * i + 2]
		if not (name) then break end
		table.insert(cats, name)
		table.insert(data, { name, changes })

		i = i + 1
	end

	local rows = {}
	local get_cat = cat_query.get_cat_function(cats)
	for _, d in ipairs(data) do
		local name, changes = d[1], d[2]
		local cat = get_cat(name)
		if args.ultra then
			cat = cat:to_form(4)
		else
			cat = cat:to_form(3)
		end

		local img = Cat.image_str(cat, 'deploy')
		local row = rowBase:format(cat.id, img, cat.rarity, changes)
		table.insert(rows, row)
	end
	return tableBase:format(table.concat(rows))
end

function p.main(frame)
	return p._main(getArgs(frame))
end

return p

