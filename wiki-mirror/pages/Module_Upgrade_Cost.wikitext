---	Implements [[Template:Upgrade Cost|Upgrade Cost]].
--
--	@author [[User:Jenny on Wiki|Jenny on Wiki]]
--	@require Module:Interpolate
local p = {}
local interpolate = require('Module:Interpolate')
local getArgs = require("Module:Arguments").getArgs
local lang = mw.language.getContentLanguage()

local base = [[<div class="upgrade-cost overflow-shadow">
{| class="table" cellpadding="2" cellspacing="1" style="width:100%;line-height:normal;border-radius:5px;border:2px solid black;background-color:black;text-align:center"
|- class="bg-orange2" style="color:white;"
| style="border-bottom:1px solid black;border-right:1px solid black" |
${headers}
| style="font-weight:bold;border-bottom:1px solid black;border-left:1px solid black;text-align:right;" |
${rows}
|- class="bg-orange2" style="color:white;"
| colspan="11" style="font-weight:bold;font-size:smaller;padding-right:5px;text-align:right;" | ${totcost}
| style="font-weight:bold;border-left:1px solid black;text-align:right;" | ${total}
|}
</div>]]

---	Add table cell for tens place
--	@param {number} place
--	@return {mw.html} td
function p._place(place)
	local td = mw.html.create('td')
	td:addClass("bg-orange2")
		:cssText("font-weight:bold;"
			.. "color:white;"
			.. "border-right:1px solid black")
		:wikitext(place .. 'x')
	return td
end

---	Add table cell for cost to upgrade to next level
--	@param {number} num
--	@param {boolean} isEven
--	@return {mw.html} td
function p._level(num, isEven)
	local class = isEven and "bg-light4" or "bg-light3"
	local td = mw.html.create('td')
	td:addClass(class):cssText("white-space:pre"):wikitext(lang:formatNum(num))
	return td
end

---	Add table cell for row's sum
--	@param {number} sum
--	@return {mw.html} td
function p._sum(sum)
	local td = mw.html.create('td')
	td:addClass("bg-orange2")
		:cssText("color:white;"
			.. "white-space:pre;"
			.. "border-left:1px solid black;"
			.. "text-align:right;")
		:wikitext(lang:formatNum(sum))
	return td
end

---	Add table cell for total XP cost
--	@param {number} total
--	@return {mw.html} td
function p._total(total)
	local td = mw.html.create('td')
	td:addClass("bg-orange2")
		:cssText("font-weight:bold;"
			.. "border-left:1px solid black;"
			.. "text-align:right;")
		:wikitext(lang:formatNum(total))
	return td
end

function p._headers()
	local headers = {}
	local leg = '| style="font-weight:bold;border-bottom:1px solid black" | '
	for i = 0, 9 do
		table.insert(headers, leg .. i)
	end
	return headers
end

function p._rows(rows)
	local _rows = {}
	for index, value in ipairs(rows) do
		table.insert(_rows, mw.allToString(value))
	end
	return table.concat(_rows)
end

function p._calc_cost(costs, args, i)
	-- to make the rest easier
	i = i - 1

	local mult = 'mult' .. math.floor(i / 10)
	local defaults = {
		mult1 = 2,
		mult2 = 3,
		mult3 = 3.5,
		mult4 = 4,
		mult5 = 4.5,
	}
	return math.floor(costs[i % 10 + 1] * (args[mult] or defaults[mult]))
end

function p.mix(args, max)
	local costs = {}
	for i, cost in ipairs(args) do
		if cost:sub(1, 1):match('%d') then
			table.insert(costs, lang:parseFormattedNumber(cost:gsub("%s", "")))
		end
	end
	assert(#costs >= 10, 'Must pass at least 10 numeric arguments')

	local freeInit = false
	if costs[1] == 0 and costs[11] then
		costs[1] = costs[11] / (args['mult1'] or 2)
		freeInit = true
	end
	for i = 1, max do
		costs[i] = costs[i] or p._calc_cost(costs, args, i)
	end

	if freeInit then costs[1] = 0 end
	return costs
end

function p._main(args)
	local repl = {}
	repl.headers = table.concat(p._headers(), '\n')

	local max = args.max or 50
	assert(max % 10 == 0, 'max must be a multiple of 10')
	local costs = p.mix(args, max)

	local rows = {}
	local total = 0
	local sum = 0
	local num
	for i = 1, max do
		if i % 10 == 1 then
			rows[#rows + 1] = mw.html.create('tr')
			rows[#rows]:node(p._place(math.floor(i / 10)))
		end
		num = costs[i]
		rows[#rows]:node(p._level(num, i % 2 == 0))
		sum = sum + num
		if i % 10 == 0 then
			total = total + sum
			rows[#rows]:node(p._sum(sum))
			sum = 0
		end
	end

	repl.rows = p._rows(rows)
	repl.total = lang:formatNum(total)
	repl.totcost = "Total XP Cost"

	return interpolate(base, repl)
end

function p.main(frame)
	return p._main(getArgs(frame))
end

return p

