--[[
	An array of 20 numbers (`int[20]`).
	@local
	@type scaling
--]]

---	Parse scaling format string into numbers.
--	@param {string} scaling Scaling, as specified in format.
--	@return {scaling}
--	@error {string} Invalid number.
--	@error {string} Scaling is not 20 numbers long.
function p.parse_scaling_format(scaling)
	local t = {}
	scaling = scaling:gsub("(%d+)x(%d+)", function(scale, repeats)
		local t2 = {}
		local s = tonumber(scale)
		for _ = 1, tonumber(repeats) do
			table.insert(t2, s)
		end
		return table.concat(t2, ',')
	end)
	for value in mw.text.gsplit(scaling, ',') do
		local n = tonumber(value)
		if not n then
			local format = 'Error when parsing scaling: "%s" is not a valid number'
			error(format:format(value))
		end
		table.insert(t, n)
	end
	assert(#t == 20, "Scaling should be 20 numbers long")
	return t
end

---	Workhorse function for `get_stat_at_level` function. Gets the `x` in
--	<math>\Bigl\lfloor \operatorname{round}\left(\text{Initial} \times x\right) \times 2.5 \Bigr\rfloor</math>
--	@param {scaling} scaling
--	@param {number} level
--	@return {number}
--	@error {string} Level is too high to get the actual stats.
function p.get_stat_multiplier_at_level(scaling, level)
	local i = 1
	local total_multiplier = 1.0

	if level <= 10 then return total_multiplier + ((level - 1) * scaling[i] / 100.0) end
	total_multiplier = total_multiplier + 9 * scaling[i] / 100.0
	level = level - 10
	i = i + 1

	local function try()
		if level <= 10 then return total_multiplier + (level * scaling[i] / 100.0) end
		total_multiplier = total_multiplier + 10 * scaling[i] / 100.0
		level = level - 10
		i = i + 1
		return false
	end

	local x
	-- this could probably be achieved with an array, or like how
	-- [[MediaWiki:Gadget-CatStatsDetailed.js]] does it by just going
	-- level-by-level
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end
	x = try(); if x then return x end

	error("Cannot get the stats of a unit at level " .. level)
end

---	Get the stat at the level specified.
--	@param {scaling} scaling
--	@param {number} initial The initial value of the stat.
--	@param {number} level Level to get the stat's value at.
function p.get_stat_at_level(scaling, initial, level)
	local raw = p.get_stat_multiplier_at_level(scaling, level) * initial
	local without_treasure = math.floor(raw + 0.5)
	-- rounding because Lua doesn't have that
	return math.floor(25 * without_treasure / 10)
end

--[[
	@local
	@table table_list
	@field {all} all
	@field forms ([@{string} -> @{form}])
	@field validation Validation parameters.
--]]

---	Get the table list.
--	@param {table} args Frame args.
--	@return {table_list}
--	@error {string} Validation incomplete.
function p.get_table_list(args)
	local is_validated = yesno(args.validation or false)
	if is_validated == nil then
		error(args.validation .. ' is not recognised as a value for validation.')
		-- only occurs if `args.validation` is provided but is not recognised by
		-- `yesno`
	end

	local all = {}
	local raw_forms = {}
	local validation = is_validated and {} or nil

	for param_name, param_value in pairs(args) do
		if awesome_data.possible.form[param_name] then
			-- form-specific
			local form, name = param_name:match("(%w+) (.*)")
			if not raw_forms[form] then
				raw_forms[form] = {}
			end
			raw_forms[form][name] = param_value
		elseif awesome_data.possible.all[param_name] then
			-- for all forms
			all[param_name] = param_value
		elseif is_validated and awesome_data.possible.validation[param_name] then
			-- validation parameter
			local form, name = param_name:match("val%-(%w+)%-(.*)")
			if not validation[form] then
				validation[form] = {}
			end
			validation[form][name] = param_value
		elseif is_validated and awesome_data.validation_params[param_name] then
			-- `validation` itself goes into this branch, but gets skipped
			-- normal maxhp and maxap get put into validation.all
			local name = param_name:match("val%-Normal%-(.*)")
			if name then
				if not validation.all then
					validation.all = {}
				end
				validation.all[name] = param_value
			end
		else
			error(mw.dumpObject(param_name) .. " is not recognised as a valid parameter")
		end
	end

	local forms = {}
	for name, data in pairs(raw_forms) do
		forms[name] = p.parse_form(name, data)
	end

	local normal = awesome_data.form_names.normal
	local evolved = awesome_data.form_names.evolved
	local tf = awesome_data.form_names.true_form
	local ultra = awesome_data.form_names.ultra

	assert(forms[normal] and forms[evolved], "Both normal and evolved forms are required")
	-- If only normal was necessary, then the max level would be hidden in the
	-- template if you only had 1 form. Therefore, might as well require having
	-- two forms.
	forms[normal].position = awesome_data.positions.start
	forms[normal].number = 1
	forms[evolved].position = awesome_data.positions.last
	forms[evolved].number = 2
	if forms[tf] then
		forms[evolved].position = awesome_data.positions.middle
		forms[tf].position = awesome_data.positions.last
		forms[tf].number = 3
	end
	if forms[ultra] then
		assert(forms[tf], "Ultra form found but missing true form")
		forms[tf].position = awesome_data.positions.middle
		forms[ultra].position = awesome_data.positions.last
		forms[ultra].number = 4
	end

	local parsed_all = {}
	parsed_all.scaling = p.parse_scaling_format(all["Scaling"])
	parsed_all.max_level = all["Lv.MAX"]
	parsed_all.orb = yesno(all["Orb"] or error("Missing orb value"))
	if parsed_all.orb == nil then
		error(all["Orb"] .. ' is not recognised as a value for detailed stats orbs.')
	end

	return { all = parsed_all, forms = forms, validation = validation }
end

--[[
	Represents a heading-value pair of table cells.
	@local
	@table table_cell
	@field {string} heading Cell heading.
	@field {string} content Cell content.
	@field {string} grid_label_base Unique label for this pair of data.
--]]

---	Get the cells for the unit stats.
--	@param {all} all
--	@param {form} form
--	@return (`table_cell[]`, `table_cell[]`)
function p.get_standard_stats_tables(all, form)
	local top_stats = {}

	local attack_cycle
	if form.kamikaze then
		attack_cycle = { false }
	else
		attack_cycle = { true, math.max(form.length, form.fore[#form.fore] + form.cooldown) }
	end

	if form.position == awesome_data.positions.start then
		local hp = ("%s HP"):format(formatnum.formatInt(form.hp))

		local ap = 0
		for _, n in ipairs(form.ap) do
			ap = ap + n
		end
		local attack = ("%s damage"):format(formatnum.formatInt(ap))
		if attack_cycle[1] then
			local dps = ap * 30 / attack_cycle[2]
			attack = attack .. ("<br>(%s DPS)"):format(formatnum.formatFloat(dps, 2))
		end

		table.insert(top_stats, {
			label = awesome_data.headings.hp,
			value = hp,
			grid_label_base = 'hp'
		})
		table.insert(top_stats, {
			label = awesome_data.headings.ap,
			value = attack,
			grid_label_base = 'ap'
		})
	else
		local hp = p.get_stat_at_level(all.scaling, form.hp, form.num_level)
		local health = ("%s HP"):format(formatnum.formatInt(hp))

		local ap = 0
		for _, n in ipairs(form.ap) do
			ap = ap + p.get_stat_at_level(all.scaling, n, form.num_level)
		end
		local attack = ("%s damage"):format(formatnum.formatInt(ap))
		if attack_cycle[1] then
			local dps = ap * 30 / attack_cycle[2]
			attack = attack .. ("<br>(%s DPS)"):format(formatnum.formatFloat(dps, 2))
		end

		table.insert(top_stats, {
			label = ("%s (Lv.%s)"):format(awesome_data.headings.hp, form.str_level),
			value = health,
			grid_label_base = 'hp'
		})
		table.insert(top_stats, {
			label = ("%s (Lv.%s)"):format(awesome_data.headings.ap, form.str_level),
			value = attack,
			grid_label_base = 'ap'
		})
	end

	table.insert(top_stats, {
		label = awesome_data.headings.range,
		value = formatnum.formatInt(form.range),
		grid_label_base = 'rng'
	})

	local frequency
	if attack_cycle[1] then
		frequency = ("%sf <sub>%s %s</sub>"):format(
			formatnum.formatInt(attack_cycle[2]),
			formatnum.formatFloat(attack_cycle[2] / 30, 2),
			attack_cycle[2] == 30 and "second" or "seconds"
		)
	else
		frequency = "-"
	end

	table.insert(top_stats, {
		label = awesome_data.headings.freq,
		value = frequency,
		grid_label_base = 'atkfreq'
	})
	table.insert(top_stats, {
		label = awesome_data.headings.speed,
		value = formatnum.formatInt(form.speed),
		grid_label_base = 'spd'
	})

	local kb = ("%s %s"):format(formatnum.formatInt(form.kb), form.kb == 1 and "time" or "times")
	table.insert(top_stats, {
		label = awesome_data.headings.kb,
		value = kb,
		grid_label_base = 'kb'
	})

	local fore = form.fore[1]
	local back = form.length - form.fore[#form.fore]
	local animation = ("%sf <sup>%ss</sup><br>(%sf <sup>%ss</sup> backswing)"):format(
		formatnum.formatInt(fore),
		formatnum.formatFloat(fore / 30, 2),
		formatnum.formatInt(back),
		formatnum.formatFloat(back / 30, 2)
	)
	table.insert(top_stats, {
		label = awesome_data.headings.anim,
		value = animation,
		grid_label_base = 'atklen'
	})

	local recharge_max = formatnum.formatFloat(form.recharge[1] / 30, 2)
	local recharge_min = formatnum.formatFloat(form.recharge[2] / 30, 2)
	local recharge = ("%s ~ %s seconds"):format(recharge_max, recharge_min)
	table.insert(top_stats, {
		label = awesome_data.headings.recharge,
		value = recharge,
		grid_label_base = 'recharge'
	})
	-- no need to consider plural as min is 2 seconds

	----------------------------------------------------------------------------

	local bottom_stats = {}

	if form.position == awesome_data.positions.start then
		local hp = p.get_stat_at_level(all.scaling, form.hp, form.num_level)
		local health = ("%s HP"):format(formatnum.formatInt(hp))

		local ap = 0
		for _, n in ipairs(form.ap) do
			ap = ap + p.get_stat_at_level(all.scaling, n, form.num_level)
		end
		local attack = ("%s damage"):format(formatnum.formatInt(ap))
		if attack_cycle[1] then
			local dps = ap * 30 / attack_cycle[2]
			attack = attack .. ("<br>(%s DPS)"):format(formatnum.formatFloat(dps, 2))
		end

		table.insert(bottom_stats, {
			label = ("%s (Lv.%s)"):format(awesome_data.headings.hp, form.str_level),
			value = health,
			grid_label_base = 'maxhp'
		})
		table.insert(bottom_stats, {
			label = ("%s (Lv.%s)"):format(awesome_data.headings.ap, form.str_level),
			value = attack,
			grid_label_base = 'maxap'
		})
	end

	if form.position == awesome_data.positions.last then
		table.insert(bottom_stats, {
			label = awesome_data.bottom_headings.max,
			value = all.max_level,
			grid_label_base = 'maxlvl'
		})
	end
	table.insert(bottom_stats, {
		label = awesome_data.bottom_headings.atktype,
		value = p.attack_type_icon(form.attack_type),
		grid_label_base = 'atktype'
	})

	table.insert(bottom_stats, {
		label = awesome_data.bottom_headings.abil,
		value = form.abilities,
		grid_label_base = 'abil',
	})

	local abil_pattern = '<span class="ability%-icons" data%-abilities="([^"]*)">'
	local abilities = {}
	for abil in string.gmatch(form.abilities, abil_pattern) do
		for _, value in ipairs(mw.text.jsonDecode(mw.text.decode(abil))) do
			abilities[#abilities + 1] = value
		end
	end

	local stats = { abilities = abilities, form = form.number }
	mw.ext.bucket('cat_stats').put(stats)

	return { top_stats, bottom_stats }
end

---	Add stats row to the table body.
--	@param {mw.html} body
--	@param row_items (`table_cell[]`)
function p.add_stats_row(body, row_items)
	for _, item in ipairs(row_items) do
		assert(item.label and item.value and item.grid_label_base)
		body:tag('div')
			:addClass('stats-cell stats-label stats-label-' .. item.grid_label_base)
			:cssText(('grid-area: lab-' .. item.grid_label_base))
			:wikitext(item.label)
		body:tag('div')
			:addClass('stats-cell stats-value stats-value-' .. item.grid_label_base)
			:cssText(('grid-area: val-' .. item.grid_label_base))
			:wikitext(item.value)
	end
end

---	Add standard form to table.
--	@param {mw.html} body Table body.
--	@param {table_list} table_list
--	@param {string} form_name
--	@note Also checks validation.
function p.get_form_table(table_list, form_name)
	local all = table_list.all
	local form = table_list.forms[form_name]

	local body = mw.html.create('div')
		:addClass('standard-cat-stats-form position-' .. form.position)

	body:tag('div')
		:addClass('stats-cell form-name')
		:cssText('grid-area: name;')
		:tag('b'):wikitext(form.name)

	local s = p.get_standard_stats_tables(all, form)

	local top = s[1]
	if table_list.validation then
		local validation = table_list.validation[form_name] or error("Validation not found for form " .. form_name)
		for code, heading in pairs(awesome_data.headings) do
			local new_label = heading
			if form.position ~= awesome_data.positions.start and (code == "hp" or code == "ap") then
				new_label = ("%s (Lv.%s)"):format(heading, form.str_level)
			end

			local checked = false
			for _, entry in ipairs(top) do
				local label, value = entry.label, entry.value
				if new_label == label then
					assert(not checked, "%s form's %s is validated multiple times")
					-- is this even possible?
					if value ~= validation[heading] then
						local fmt = "Validation failed for parameter %s: %s (calculated) ~= %s (given)"
						local msg = fmt:format(
							mw.dumpObject(new_label),
							mw.dumpObject(value),
							mw.dumpObject(validation[heading])
						)
						error(msg)
					end
					checked = true
				end
			end
			if not checked then
				error(("%s form's %s is never validated"):format(form_name, mw.dumpObject(new_label)))
			end
		end
	end

	local bottom = s[2]
	if table_list.validation and form.position == awesome_data.positions.start then
		local val_all = table_list.validation.all

		local hp_param = "MaxHP"
		local hp_heading = ("%s (Lv.%s)"):format(awesome_data.headings.hp, form.str_level)
		if bottom[1].label ~= hp_heading then
			local fmt = "Internal module error: hp heading is incorrect. Should have been %s, found %s"
			error(fmt:format(mw.dumpObject(hp_heading), mw.dumpObject(bottom[1].label)))
		end
		if bottom[1].value ~= val_all[hp_param] then
			-- ("val-Normal-%s"):format("MaxHP")
			local fmt = "Validation for %s was incorrect: parameter given was %s, parameter calculated was %s"
			local msg = fmt:format(
				mw.dumpObject(hp_param),
				mw.dumpObject(val_all[hp_param]),
				mw.dumpObject(bottom[1].value)
			)
			error(msg)
		end

		local ap_param = "MaxAttack"
		local ap_label = ("%s (Lv.%s)"):format(awesome_data.headings.ap, form.str_level)
		if bottom[2].label ~= ap_label then
			local fmt = "Internal module error: ap heading is incorrect. Should have been %s, found %s"
			error(fmt:format(mw.dumpObject(ap_label), mw.dumpObject(bottom[2].label)))
		end
		if bottom[2].value ~= val_all[ap_param] then
			local fmt = "Validation for %s was incorrect: parameter given was %s, parameter calculated was %s"
			local msg = fmt:format(
				mw.dumpObject(ap_param),
				mw.dumpObject(val_all[ap_param]),
				mw.dumpObject(bottom[2].value)
			)
			error(msg)
		end
	end

	p.add_stats_row(body, top)
	p.add_stats_row(body, bottom)

	return body
end

---	Get the standard table.
--	@param {table_list} table_list
--	@return {mw.html}
function p.standard(table_list)
	local body = mw.html.create('div')
		:addClass('standard-cat-stats-table overflow-shadow')

	local f
	f = awesome_data.form_names.normal
	if table_list.forms[f] then body:node(p.get_form_table(table_list, f)) end
	f = awesome_data.form_names.evolved
	if table_list.forms[f] then body:node(p.get_form_table(table_list, f)) end
	f = awesome_data.form_names.true_form
	if table_list.forms[f] then body:node(p.get_form_table(table_list, f)) end
	f = awesome_data.form_names.ultra
	if table_list.forms[f] then body:node(p.get_form_table(table_list, f)) end

	return body
end

---	Helper function for `get_detailed_form`.
--	@param {string} cell_type Class to use for the cell.
--	@param {string} grid_area Name for grid area.
--	@param {string} content Wikitext to place in cell.
local function get_cell(cell_type, grid_area, content)
	return mw.html.create('div')
		:addClass('stats-table-cell')
		:addClass(('cell-%s'):format(cell_type))
		:wikitext(content)
		:cssText('grid-area: ' .. grid_area)
end

---	I wonder what this function does.
--	@param {table_list} table_list
--	@param {string} form_name
--	@param {boolean} orb_valid
--	@return {string}
function p.get_detailed_form(table_list, form_name, orb_valid)
	local label = 'label'
	local entry = 'label cell-input'
	local value = 'value'
	local result = 'value stat-'
	local duration = 'value time-toggle'

	local all = table_list.all
	local form = table_list.forms[form_name]

	local container = mw.html.create('div')
		:addClass('detailed-cat-stats-form')

	local attack_cycle = math.max(form.length, form.fore[#form.fore] + form.cooldown)
	container
		:node(get_cell('name', 'name', form.name))

	container
		:node(get_cell('mod', 'modlabh', 'Health Buff (%)'))
		:node(get_cell('mod health-buff', 'modvalh', ''))
		:node(get_cell('mod', 'modlaba', 'Attack Buff (%)'))
		:node(get_cell('mod attack-buff', 'modvala', ''))

	if all.orb and orb_valid then
		container:addClass('orb-valid')
			:node(get_cell('mod', 'orblabh', 'Defense Orb (%)'))
			:node(get_cell('mod health-orb', 'orbvalh', ''))
			:node(get_cell('mod', 'orblaba', 'Attack Orb (IS)'))
			:node(get_cell('mod attack-orb', 'orbvala', ''))
	end

	container
		:node(get_cell(label, 'lablvl', 'Level'))
		:node(get_cell(label, 'labhp', 'HP'))
		:node(get_cell(label, 'labap', 'AP'))
		:node(get_cell(label, 'labdps', 'DPS'))
		:node(get_cell(label, 'labac', 'Attack Cycle'))
		:node(get_cell(duration, 'valac', formatnum.formatInt(attack_cycle))
			:attr('data-frames', attack_cycle))

	local ap = 0
	for _, n in ipairs(form.ap) do
		ap = ap + n
	end
	local backswing = form.length - form.fore[#form.fore]
	container
		:node(get_cell(label, 'labbase', 'Base'))
		:node(get_cell(value, 'valhpb', formatnum.formatInt(form.hp)))
		:node(get_cell(value, 'valapb', formatnum.formatInt(ap)))
		:node(get_cell(value, 'valdpsb', formatnum.formatFloat(ap * 30 / attack_cycle, 2)))
		:node(get_cell(label, 'labfore', 'Foreswing'))
		:node(get_cell(duration, 'valfore', table.concat(form.fore, '/'))
			:attr('data-frames', mw.text.jsonEncode(form.fore)))
		:node(get_cell(label, 'labback', 'Backswing'))
		:node(get_cell(duration, 'valback', formatnum.formatInt(backswing))
			:attr('data-frames', backswing))

	local hp_at_level = p.get_stat_at_level(all.scaling, form.hp, form.num_level)
	local ap_at_level = 0
	for _, n in ipairs(form.ap) do
		ap_at_level = ap_at_level + p.get_stat_at_level(all.scaling, n, form.num_level)
	end
	local dps_at_level = ap_at_level * 30 / attack_cycle

	container
		:node(get_cell(entry, 'labcalc', form.str_level):attr({
			['data-hp'] = form.hp,
			['data-ap'] = mw.text.jsonEncode(form.ap),
			['data-cycle'] = attack_cycle
		}))
		:node(get_cell(result .. 'hp', 'valhpc', formatnum.formatInt(hp_at_level)))
		:node(get_cell(result .. 'ap', 'valapc', formatnum.formatInt(ap_at_level)))
		:node(get_cell(result .. 'dps', 'valdpsc', formatnum.formatFloat(dps_at_level, 2)))
		:node(get_cell(label, 'labacd', 'Attack CD'))
		:node(get_cell(duration, 'valacd', form.cooldown):attr('data-frames', form.cooldown))

	container
		:node(get_cell(label, 'labat', 'Attack Type'))
		:node(get_cell(label, 'labkb', 'Knockbacks'))
		:node(get_cell(label, 'labrng', 'Range'))
		:node(get_cell(label, 'labspd', 'Speed'))
		:node(get_cell(label, 'labrech', 'Recharge'))
		:node(get_cell(label, 'labcost', 'Cost'))

	local costs = ("%s/%s/%s¢"):format(
		formatnum.formatInt(form.cost),
		formatnum.formatInt(math.floor(form.cost * 3 / 2)),
		formatnum.formatInt(form.cost * 2)
	)
	local recharge_max = formatnum.formatFloat(form.recharge[1] / 30, 2)
	local recharge_min = formatnum.formatFloat(form.recharge[2] / 30, 2)
	local recharge = ("%s ~ %s seconds"):format(recharge_max, recharge_min)
	container
		:node(get_cell(value, 'valat', form.attack_type))
		:node(get_cell(value, 'valkb', formatnum.formatInt(form.kb)))
		:node(get_cell(value, 'valrng', formatnum.formatInt(form.range)))
		:node(get_cell(value, 'valspd', formatnum.formatInt(form.speed)))
		:node(get_cell(value, 'valrech', recharge))
		:node(get_cell(value, 'valcost', costs))

	local is_last = form.position == awesome_data.positions.last
	local bottomLabel = container
		:node(get_cell(label, 'lababil', 'Abilities'))
	if is_last then
		bottomLabel:node(get_cell('label max-level', 'labmax', 'Lv.MAX'))
	end
	local is_empty = ''
	if (form.abilities == '-') then
		is_empty = ' abilities-empty'
	end

	local bottomValue = container:node(get_cell('value abilities' .. is_empty, 'valabil', form.abilities))
	if form.position == awesome_data.positions.start then
		container:addClass('first-form')
	end
	if is_last then
		container:addClass('final-form')
		bottomValue:node(get_cell('value max-level', 'valmax', all.max_level))
	end

	return container
end

---	Get controls table above detailed stats table
--	@return {mw.html}
function p.get_detailed_controls()
	local controls = mw.html.create('table')
		:addClass('detailed-cat-stats-controls')
		:attr({ cellpadding = "0", cellspacing = "0" })

	local function get_cell(tag, class, content, colspan, rowspan)
		return mw.html.create(tag)
			:addClass(class)
			:wikitext(content)
			:attr({ colspan = colspan, rowspan = rowspan })
	end

	controls:tag('tr')
		:node(get_cell('th', '', 'Stats Modifier', 4))

	controls:tag('tr')
		:node(get_cell('td', '', 'Level'))
		:node(get_cell('td', 'global-level', ''))
		:node(get_cell('td', '', "Decimal Places '''[DPS]'''"))
		:node(get_cell('td', 'decimal-places', ''))

	controls:tag('tr')
		:node(get_cell('td', '', 'Health Treasure'))
		:node(get_cell('td', 'health-treasure', ''))
		:node(get_cell('td', '', 'Attack Treasure'))
		:node(get_cell('td', 'attack-treasure', ''))

	controls:tag('tr')
		:node(get_cell('td', '', 'Abilities'))
		:node(get_cell('td', 'ability-toggle', ''))
		:node(get_cell('td', '', 'Durations'))
		:node(get_cell('td', 'duration-toggle', ''))

	return controls
end

---	Get detailed cat stats.
--	@param {table_list} table_list
--	@return {mw.html}
function p.detailed(table_list)
	local controls = p.get_detailed_controls()

	local grid_part = mw.html.create('div')
		:addClass('detailed-cat-stats-table')
		:attr({ ['data-scaling'] = mw.text.jsonEncode(table_list.all.scaling) })

	local f
	f = awesome_data.form_names.normal
	if table_list.forms[f] then grid_part:node(p.get_detailed_form(table_list, f, false)) end
	f = awesome_data.form_names.evolved
	if table_list.forms[f] then grid_part:node(p.get_detailed_form(table_list, f, false)) end
	f = awesome_data.form_names.true_form
	if table_list.forms[f] then grid_part:node(p.get_detailed_form(table_list, f, true)) end
	f = awesome_data.form_names.ultra
	if table_list.forms[f] then grid_part:node(p.get_detailed_form(table_list, f, true)) end

	return tostring(controls) .. '\n\n' .. tostring(grid_part)
end

---	Main function executor.
--	@param {table} args Frame args.
--	@return {mw.html} Rendered tabber.
function p._main(args)
	local table_list = p.get_table_list(args)
	local standard = tostring(p.standard(table_list)) .. '\n' .. awesome_data.explanations.standard
	local detailed = p.detailed(table_list) .. '\n' .. awesome_data.explanations.detailed

	return mw.html.create('div'):node(mw.ext.tabber.render {
		{ label = 'Standard', content = standard },
		{ label = 'Detailed', content = detailed }
	}):addClass('cat-stats-template')
end

function p.main(frame)
	return p._main(getArgs(frame))
end

return p

