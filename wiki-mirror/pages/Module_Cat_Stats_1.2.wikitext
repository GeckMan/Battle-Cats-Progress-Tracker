---	Get icon for the attack type.
--	@param {string} attack_type
--	@return {string}
--	@error {string} Attack type is not `"Single"` or `"Area"`.
function p.attack_type_icon(attack_type)
	if not (attack_type == "Single" or attack_type == "Area") then
		return error(mw.dumpObject(attack_type) .. " is not recognised as a valid attack type")
	end

	local format = "[[File:%s Attack.png|link=Special Abilities#%s Attack|%s Attack]]"
	return format:format(attack_type, attack_type, attack_type)
end

---	Parse form data into @{form} representation. Also checks that all data is
--	valid.
--	@param {string} form_name Name (`"Normal"`, `"Evolved"` etc.)
--	@param {raw_form} data Form data
--	@return {form}
--	@error {string} Missing parameter
--	@error {string} Non-numeric input where numeric input expected.
function p.parse_form(form_name, data)
	-- construct the list of tables
	-- {...params, position, parsed: {level, scaling, orb}}
	-- utility data: positions, switches (area/single), perhaps extra lines
	-- need something different for multihit, maybe just 1680,1680,1680
	local defaults = awesome_data.param_data.defaults
	for _, param_name in ipairs(awesome_data.param_data.params) do
		if not data[param_name] then
			local full = form_name .. " " .. param_name
			data[param_name] = defaults[full] or
				defaults[param_name] or
				error(('Parameter "%s" is missing'):format(full))
		end
	end

	-- parse single int
	local function parse_int(param_name)
		return tonumber(data[param_name])
			or error(('"%s %s" is not numeric'):format(form_name, param_name))
	end
	-- parse multiple ints e.g. `"1,1,1"` -> `[1, 1, 1]`
	local function parse_int_multi(param_name)
		local t = {}
		for value in mw.text.gsplit(data[param_name], ',') do
			local n = tonumber(value)
			if not n then
				local format = '"%s %s" is not a comma-separated list of numbers'
				error(format:format(form_name, param_name))
			end
			table.insert(t, n)
		end
		return t
	end

	local parsed = {}
	parsed.name = data["Name"]
	parsed.hp = parse_int("Base HP")
	parsed.ap = parse_int_multi("Base AP")
	parsed.range = parse_int("Range")
	parsed.fore = parse_int_multi("Foreswing")
	parsed.cooldown = parse_int("Attack Cooldown")
	parsed.length = parse_int("Attack Length")
	parsed.speed = parse_int("Speed")
	parsed.kb = parse_int("KB")
	parsed.cost = parse_int("Cost")

	local recharge = parse_int("Recharge")
	local MAX_RECHARGE_DISCOUNT = 264
	local MIN_RECHARGE = 60
	parsed.recharge = { recharge, math.max(recharge - MAX_RECHARGE_DISCOUNT, MIN_RECHARGE) }

	parsed.attack_type = data["Attack Type"]

	local targets = data["Targets"]
	local traits = ''
	if targets ~= '-' then
		for _, trait in ipairs(awesome_data.traits) do
			local class = 'trait'
			local category = ''
			local alt = ''
			if targets:find(trait) then
				class = class .. ' target'
				category = "Category:" .. trait .. " Enemies"
				alt = trait .. '&nbsp;'
			else
				alt = '&ZeroWidthSpace;'
			end
			-- accessibility: if user cannot load images, then you want them to
			-- see a list of traits using the alt text
			-- therefore if the unit has the trait, use trait as alt text, if
			-- unit does not have trait, make alt text blank (which is best done
			-- with zero-width space)
			local fmt = '[[File:%straiticon.png|30px|link=%s|class=%s|%s|alt=%s]]'
			traits = traits .. fmt:format(trait, category, class, trait, alt)
		end
		traits = ('<div class="target-list">%s</div>'):format(traits)
		-- put in <div> to have trait icons on their own line
	end
	parsed.abilities = traits
		.. data["Abilities"]:gsub('%s*<br>%s*', '<br>')
	-- <br> followed by newline creates a paragraph break, this fixes that
	-- problem

	local level = data["Stats Level"]
	parsed.str_level = level
	local nat, plus = level:match('^(%d+)%+(%d+)$')
	if nat then
		parsed.num_level = tonumber(nat) + tonumber(plus)
	else
		parsed.num_level = parse_int("Stats Level")
	end

	parsed.kamikaze = yesno(data["Kamikaze"])
	if parsed.kamikaze == nil then
		error(data["Kamikaze"] .. ' is not recognised as a true or false value.')
	end

	return parsed
end

