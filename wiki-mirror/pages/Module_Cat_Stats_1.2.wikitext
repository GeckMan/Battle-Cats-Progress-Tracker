---@alias Set { [string]: true }

---Set of all valid parameters for the template.
---@class PossibleParams
---@field form Set Form-specific parameters
---@field all Set All-form parameters
---@field validation Set Validation parameters

---Get all possible parameter names.
---@return PossibleParams
function p.get_possible_params()
	---@type PossibleParams
	local possible_params = {
		form = {},
		all = {},
		validation = {},
	}
	-- probably should be extracted out to a data module along with the rest of
	-- the param data
	for _, form in pairs(awesome_data.form_names) do
		for _, name in ipairs(awesome_data.param_data.params) do
			local n = form .. " " .. name
			possible_params.form[n] = true
		end
		for _, name in pairs(awesome_data.headings) do
			local val = ("val-%s-%s"):format(form, name)
			possible_params.validation[val] = true
		end
	end
	for _, name in ipairs(awesome_data.param_data.others) do
		possible_params.all[name] = true
	end

	return possible_params
end

awesome_data.possible = p.get_possible_params()



