.demo {
	margin: 1em 0;
	border: 1px solid var(--border-color-base, #a2a9b1);
	border-radius: 2px;
}

.demo-label {
	padding: 0.25em 0.5em;
	background-color: var(--background-color-neutral, #eaecf0);
	font-size: 0.875em;
	font-weight: bold;
}

.demo-wikitext {
	background-color: var(--background-color-neutral-subtle, #f8f9fa);
}

.demo-wikitext .mw-highlight,
.demo-wikitext pre {
	margin: 0;
	border: 0;
	border-radius: 0;
}

.demo-wikitext .mw-highlight-copy-button {
	top: -1.75em;
	right: 0.5em;
}

.demo-result {
	border-top: 1px solid var(--border-color-base, #a2a9b1);
}

.demo-output {
	background-color: var(--background-color-base, #fff);
	padding: 0.75em;
	overflow-x: auto;
}

.demo-output > :first-child {
	margin-top: 0;
}

.demo-output > :last-child {
	margin-bottom: 0;
}

@media (min-width: 720px) {
	.demo-columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
	}

	.demo-columns .demo-result {
		border-top: 0;
		border-left: 1px solid var(--border-color-base, #a2a9b1);
	}
}