---	Module backend of [[Template:Stars]] and [[Template:Map Stars]].
--
--	@module	Stars
--	@alias p
--	@author [[User:SweetDonut0|SweetDonut0]]
--	@require Module:Tobinary
local p = {}
local getArgs = require('Module:Arguments').getArgs
local toBinary = require('Module:Tobinary')

---	Main function to output star images
function p.main(frame)
	return p._main(getArgs(frame))
end

---	Converts the passed number into binary, reverses the digits, and replaces with star images
function p._main(args)
	if not args[1] then return ("[[File:Star0.png|link=|alt=Star]]"):rep(12) end
	local binary = toBinary(args[1], 12):reverse()
	local stars = binary:gsub("(.)", "[[File:Star%1.png|link=|alt=Star]]")
	return stars
end

---	Outputs the background color based on the passed difficulty value as a hexadecimal color code
function p.color(frame)
	local args = getArgs(frame)
	if not args[1] then return "#fff" end
	local rgb = p.rainbow(math.log(args[1] + 1) / math.log(2) / 12 * 100)
	local code = ""
	for _, item in ipairs(rgb) do
		code = code .. ("%02x"):format(item)
	end
	return code
end

---	Returns a color in a rainbow gradient given a percentage for where the pick the color
--	@param {number} percent
--	@return {table} A triple of rgb values at the given position in the rainbow gradient
function p.rainbow(percent)
	-- Two tables define the gradient using predefined steps such that linear gradients complete the rainbow
	local steps = {"#C200EF", "#6385B7", "#87C529", "#C8C22A", "#F3B600", "#F35000"} -- Purple to red
	local stepPercents = {0, 26, 45, 62, 78, 100}
	local stepNum = #steps
	for i = 1, stepNum do
		if percent <= stepPercents[i+1] then
			return p.gradient(steps[i], steps[i+1], stepPercents[i+1] - stepPercents[i], percent - stepPercents[i])
		end
	end
	return p.rgb(steps[stepNum])
end

---	Returns the rgb values of the color by a linear gradient
--	@param {string | table} color1 A hexadecimal color code as a string or a triple of rgb values for the beginning
--	@param {string | table} color2 A hexadecimal color code as a string or a triple of rgb values for the ending
--	@param {number} total Width of percentages in gradient
--	@param {number} num Wanted percentage in gradient
--	@return {table} A triple of rgb values for the color genreated by the linear gradient defined by passed values
function p.gradient(color1, color2, total, num)
	local result = {}
	if type(color1) ~= 'table' then
		color1 = p.rgb(color1)
	end
	if type(color2) ~= 'table' then
		color2 = p.rgb(color2)
	end
	for i = 1, 3 do
		table.insert(result, p.linear(color1[i], color2[i], total, num))
	end
	return result
end

---	Returns a linear interpolation of the passed values, modified to fit properties of indexing
--	@param {number} y1 y value of first point
--	@param {number} y2 y value of second point
--	@param {number} dx Difference in x values of points, delta x
--	@param {number} x Position to interpolate relative to x1
--	@return {number} Value from linear interpolation
function p.linear(y1, y2, dx, x)
	return (y2 - y1) / (dx - 1) * (x - 1) + y1
end

---	Converts a hexadecimal color code into a triple of decimal rgb values
--	@param {string} color A hexadecimal color code as a string
--	@return {table} A triple of rgb values
function p.rgb(color)
	local result = color:gsub("#", "")
	result = {result:sub(1, 2), result:sub(3, 4), result:sub(5, 6)}
	for i = 1, 3 do
		result[i] = tonumber(result[i], 16)
	end
	return result
end

return p

