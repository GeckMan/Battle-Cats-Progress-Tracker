.detailed-cat-stats-controls {
	width: 100%;
	margin: 10px 0;
	padding-bottom: 3px;
	border-radius: 5px;
	text-align: center;
	border: 1px solid var(--theme-border-color);
}

.detailed-cat-stats-controls th {
	padding: 2px;
	background: var(--theme-page-background-color--secondary);
}

.detailed-cat-stats-controls input,
.detailed-cat-stats-controls button {
	margin-top: 3px;
}

.detailed-cat-stats-controls input {
	max-width: 5rem;
	padding: 4px 0;
	background: var(--bg-color-gray);
	border: none;
	border-radius: 5px;
	text-align: center;
}

.detailed-cat-stats-controls button {
	padding: 3px 6px;
	background: var(--theme-page-background-color--secondary);
	border-radius: 5px;
	border: 1px solid var(--theme-page-text-color);
	cursor: pointer;
}

@media (hover: hover) {
	.detailed-cat-stats-controls button:hover {
		filter: brightness(0.95);
	}
}
	

.detailed-cat-stats-form {
	display: grid;
	width: 100%;
	border-radius: 0;
	border: 3px solid #000;
	border-left-width: 2px;
	border-bottom-width: 0;
	box-sizing: border-box;
	text-align: center;
}

.detailed-cat-stats-form.first-form {
	border-radius: 5px 5px 0 0;
}

.detailed-cat-stats-form.final-form {
	border-bottom-width: 3px;
	border-radius: 0 0 5px 5px;
}

