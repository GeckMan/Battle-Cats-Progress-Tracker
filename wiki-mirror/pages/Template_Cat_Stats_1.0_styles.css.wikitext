			"labcalc valhpc  valapc  valdpsc labfore valfore labacd  valacd "
			"labat   labkb   labrng  labspd  labrech labrech labcost labcost"
			"valat   valkb   valrng  valspd  valrech valrech valcost valcost"
			"lababil lababil lababil lababil lababil lababil lababil lababil"
			"valabil valabil valabil valabil valabil valabil valabil valabil";
	}

