			"lablvl  labhp   labap   labdps  labac   labac   valac   valac  "
			"labbase valhpb  valapb  valdpsb labfore valfore labback valback"
			"labcalc valhpc  valapc  valdpsc labfore valfore labacd  valacd "
			"labat   labkb   labrng  labspd  labrech labrech labcost labcost"
