@media screen and (max-width: 600px) {
	.detailed-cat-stats-table {
		font-size: 0.8rem;
	}

	.detailed-cat-stats-form {
		grid-template-areas:
			"name    name    name    name   "
			"modlabh modvalh modlaba modvala"
			"orblabh orbvalh orblaba orbvala"
			"lablvl  labhp   labap   labdps "
			"labbase valhpb  valapb  valdpsb"
			"labcalc valhpc  valapc  valdpsc"
			"labac   labac   valac   valac  "
			"labfore valfore labacd  valacd "
			"labfore valfore labback valback"
			"labat   labkb   labrng  labspd "
			"valat   valkb   valrng  valspd "
			"labrech labrech labcost labcost"
			"valrech valrech valcost valcost"
			"labmax  labmax  labmax  labmax "
			"valmax  valmax  valmax  valmax "
			"lababil lababil lababil lababil"
			"valabil valabil valabil valabil";
	}

	.detailed-cat-stats-table .detailed-cat-stats-form .cell-mod:nth-child(6) {
		border-width: 1px 0 0 1px;
	}
}

.detailed-cat-stats-form .stats-table-cell {
	display: block;
	text-align: center;
	align-content: center;
	padding: 3px;
}

.detailed-cat-stats-form .stats-table-cell.abilities {
	text-align: left;
}

.detailed-cat-stats-form .cell-name {
	color: white;
	background-color: var(--bg-color-orange2);
	border-bottom: 1px solid #000;
	font-weight: bold;
}

.detailed-cat-stats-form .cell-mod {
	background: var(--theme-page-background-color--secondary);
}

.detailed-cat-stats-form .cell-mod ~ .cell-mod {
	margin-left: -1px;
}

.detailed-cat-stats-form .cell-label {
	background: var(--bg-color-light4);
	font-weight: bold;
}

.detailed-cat-stats-form .cell-value {
	background: var(--bg-color-light3);
}

.detailed-cat-stats-table .time-toggle::after {
	content: "f";
}

.detailed-cat-stats-table.duration-seconds .time-toggle::after {
	content: "s";
}

.detailed-cat-stats-table.ability-simple .stats-table-cell.abilities:not(.abilities-empty) {
	font-size: 0;
	text-align: center;
}

.detailed-cat-stats-table.ability-simple .stats-table-cell.abilities > * {
	display: none;
}

.detailed-cat-stats-table.ability-simple .stats-table-cell.abilities > span[typeof="mw:File"] {
	display: inline;
}

.detailed-cat-stats-form input {
	width: 3rem;
	background: var(--bg-color-gray);
	border: none;
	border-radius: 5px;
	text-align: center;
	font-weight: bold;
}

