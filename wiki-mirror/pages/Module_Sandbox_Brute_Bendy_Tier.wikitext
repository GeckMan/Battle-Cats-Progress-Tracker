local p = {}
local getArgs = require('Module:Arguments').getArgs

function p._main(args)
	local new = {}
    for index, item in ipairs(args) do
        if index == 1 then
            table.insert(new, string.format("|-\n! %s Tier", item))
        elseif index == 2 then
            table.insert(new, string.format("\n| [[File:Uni%s.png|x125px]]", item))
        else
           table.insert(new, string.format(" [[File:Uni%s.png|x125px]]", item))
        end
    end
    return table.concat(new, "")
end

function p.main(frame)
	return p._main(getArgs(frame))
end
return p

